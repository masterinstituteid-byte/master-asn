# ============================================================
# Contoh variabel lingkungan — SALIN nilainya ke panel Coolify
# (JANGAN commit file .env yang berisi nilai asli).
# ============================================================

# WAJIB. Kunci rahasia untuk menandatangani sesi login.
# Buat string acak panjang, mis. hasil dari:  openssl rand -base64 32
AUTH_SECRET=

# WAJIB. Lokasi database SQLite. Di server arahkan ke volume permanen.
DATABASE_URL=file:/app/data/prod.db

# WAJIB. Folder penyimpanan file (PDF modul). Arahkan ke volume permanen.
DATA_DIR=/app/data

# WAJIB. Email yang otomatis menjadi admin.
# Daftar akun dengan email ini setelah web online untuk mendapat akses /admin.
ADMIN_EMAIL=email-anda@contoh.com

# OPSIONAL. Login Google (isi bila sudah punya kredensial Google Cloud).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
